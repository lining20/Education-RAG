# 仅作配置模板，程序不会读取或自动同步本文件；实际配置来自 .env。
# 配置规则：源码定位项目根目录 .env；进程环境优先；缺失/空白值采用代码默认。
# 必填连接参数仅在使用服务时校验；这里全部是占位，不能复制真实密钥。
# PROJECT_ROOT 可选：覆盖项目根目录，必须为已存在目录；通常留空。
PROJECT_ROOT=

# Milvus：导入时自动准备缺失的四个集合；已有集合仅校验，超时单位秒。
MILVUS_URL=http://localhost:19530
MILVUS_TIMEOUT=10
COURSES_COLLECTION=education_courses
DOCUMENT_CHUNKS_COLLECTION=education_document_chunks
QUESTIONS_COLLECTION=education_questions
DOCUMENT_INDEX_COLLECTION=education_document_index

# MongoDB：会话历史按 session_id 关联；上传账号/登录会话使用 upload_users/upload_sessions。
# 不保存导入任务、文档或课程/题目；账号通过 scripts.create_upload_user 交互创建，不在 .env 存明文密码。
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=education
# 会话消息集合；会话列表从消息聚合，不新增业务集合。
MONGO_CHAT_MESSAGE_COLLECTION=chat_message
# MongoDB 超时单位毫秒；历史工具与上传鉴权共用客户端工厂。
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=10000

# MinIO：endpoint 不含 http/https、凭据或路径，协议仅由 SECURE 控制。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=education
# 所有 common/config 布尔项均支持 true/false、1/0、yes/no、on/off，忽略大小写。
MINIO_SECURE=false

# OpenAI 兼容 LLM：使用时要求 API_KEY 和 BASE_URL；温度默认 0.1，允许 0-2，0 原样保留。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://example.invalid/v1
LLM_DEFAULT_MODEL=qwen3-32b
LLM_DEFAULT_TEMPERATURE=0.1
# 暂停图片视觉识别；原图仍提取并归档。恢复时改为 true。
IMAGE_UNDERSTANDING_ENABLED=false
# 启用图片识别且文档含图片时必填，与上面的地址、密钥共用视觉接口。
VL_MODEL=
# 参考项目的滑动窗口：60秒最多3000次，额度内立即放行。
VL_MAX_REQUESTS=3000
VL_RATE_WINDOW_SECONDS=60

# Embedding：本地 PATH > BGE_M3 仓库名 > BAAI/bge-m3。
# PATH 须为现有模型目录；相对路径相对项目根目录，缺失目录直接报错，不回退下载。
# 未填 PATH 时模型 getter 使用仓库名，SDK 可能下载；仅导入配置不会下载。
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
# cpu / cuda / cuda:N / mps；默认 cpu，不自动探测硬件。
BGE_DEVICE=cpu
# FP16 为请求值；仅 cuda 生效，cpu/mps 实际强制 false。
BGE_FP16=false

# Reranker：PATH > LARGE > BAAI/bge-reranker-large；LARGE 兼容已有本地目录配置。
# 新本地目录请明确用 PATH，避免相对目录与 owner/model 仓库名歧义。
# 缺失绝对路径或 ./、../ 路径会报错；仓库模式的 SDK 也可能下载。
BGE_RERANKER_PATH=
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false

# PDF 使用 MinerU 转 Markdown，需要 token；MD/DOCX 本地解析不需要。
# 超时/轮询间隔单位秒，次数为正整数。
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
MINERU_REQUEST_TIMEOUT=30
MINERU_POLL_INTERVAL=5
MINERU_MAX_POLL_ATTEMPTS=60

# 勾选联网搜索时使用百炼 MCP 广场的“联网搜索”服务。
MCP_DASHSCOPE_BASE_URL=
# 可选独立密钥；留空时使用 OPENAI_API_KEY。文本模型使用其他服务商时填写百炼密钥。
MCP_DASHSCOPE_API_KEY=

# 日志配置由应用入口显式 init_logger() 读取，支持同步/异步节点。
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
